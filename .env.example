# ETF Price Viewer - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ===================================
# API Keys (for future use)
# ===================================

# Public Data Portal API Key
# Get your key at: https://www.data.go.kr/data/15094806/openapi.do
PUBLIC_DATA_PORTAL_KEY=your-public-data-portal-api-key-here

# KRX (Korea Exchange) API Key
# Get your key at: https://data.krx.co.kr
KRX_API_KEY=your-krx-api-key-here

# Korea Investment Securities API
# Get your keys at: https://apiportal.koreainvestment.com
KIS_APP_KEY=your-kis-app-key-here
KIS_APP_SECRET=your-kis-app-secret-here

# ===================================
# Application Settings
# ===================================

# Enable/Disable Mock Data (true/false)
USE_MOCK_DATA=true

# API Request Timeout (milliseconds)
API_TIMEOUT=10000

# ===================================
# Development Settings
# ===================================

# Local Development Port
DEV_PORT=8000

# Enable Debug Mode (true/false)
DEBUG_MODE=false

# ===================================
# Notes
# ===================================
# - Never commit .env or .env.local files to Git
# - Keep your API keys secret
# - Use different keys for development and production
# - Check .gitignore to ensure .env files are excluded
